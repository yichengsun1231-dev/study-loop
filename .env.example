# Copy to .dev.vars for local Wrangler. Use Sites runtime settings for production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set explicit current provider prices to enable numeric cost estimates; otherwise shown as unknown.
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
BILLING_MODE=test
BILLING_LIVE_ENABLED=false
# Comma-separated dispatch user IDs. No first-user/admin escalation.
ADMIN_USER_IDS=
SITE_URL=https://kleos-learning-agent.yichengsun1231.chatgpt.site
# Local only. NEVER configure on a hosted deployment.
DEV_AUTH=false
