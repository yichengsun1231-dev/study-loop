{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kleos",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/health"]},
  "d1_databases": [{"binding": "DB", "database_name": "kleos", "database_id": "local-kleos", "migrations_dir": "migrations"}],
  "r2_buckets": [{"binding": "BUCKET", "bucket_name": "kleos-files"}],
  "vars": {"OPENAI_MODEL": "gpt-4.1-mini", "BILLING_MODE": "test"}
}
